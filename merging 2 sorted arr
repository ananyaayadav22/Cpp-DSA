#include  <bits/stdc++.h>
#include <iostream>
using namespace std;

vector<int> sorted(vector<int>& arr1, vector<int>& arr2){
    int i = 0; int j = 0;
    vector <int> merged;
    while(i< arr1.size() && j <arr2.size()){
        if (arr1[i]<arr2[j]){
            merged.push_back(arr1[i]);
            i++;
        }
        if (arr1[i]>arr2[j]){
            merged.push_back(arr2[j]);
            j++;
        }
    }
    
    while (i < arr1.size()){
        merged.push_back(arr1[i]);
        i++;
    }
    while (j < arr2.size()){
        merged.push_back(arr2[j]);
        j++;
    }
    
    return merged;
}

int main(){
    int m,n;
    cout<<"len of ar1: ";
    cin>>m;
    vector<int> arr1(m);
    cout<<"enter arr1";
    for (int i = 0; i<m; i++){
        cin>>arr1[i];
    }
    
    cout<<"len of ar2: ";
    cin>>n;
    vector<int> arr2(n);
    cout<<"enter arr2 ";
    for (int i = 0; i<n; i++){
        cin>>arr2[i];
    }
    
    vector<int> result = sorted(arr1, arr2);
    
    cout<<"Merged array: ";
    for (int i =0; i< result.size(); i++){
        cout<<result[i]<<" ";
    }
    
    return 0;
    
}
