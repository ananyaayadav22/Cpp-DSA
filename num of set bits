#include  <bits/stdc++.h>
#include <iostream>
using namespace std;

int binary(int n){
    int count = 0;
    while (n){
        count = count + (n&1);
        n >>= 1;
    }
    return count;
}

int main(){
    int n;
    cout<<"enter the number: ";
    cin>> n;
    
    cout<<"no. of set bits : "<<binary(n);
}
