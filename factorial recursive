#include  <bits/stdc++.h>
#include <iostream>
using namespace std;

long long factorial(int n){
    long long fact = 1;
    if (n<=1){
        return 1;
    }
    return n * factorial(n-1);
}

int main(){
    int n;
    cout<<"enter the number: ";
    cin>> n;
    
    cout<<"fact : "<<factorial(n);
}
