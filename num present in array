#include <bits/stdc++.h>
using namespace std;

bool isPresent(int arr[], int size, int n){
    for (int i=0; i < size; i++){
        if (arr[i] == n){
            return true;
            break;
        }
    }
    return false;
}

int main(){
    int arr[5] = {1,2,3,4,5};
    
    cout<<isPresent(arr,sizeof(arr)/sizeof(int), 6);
    return 0;
}
